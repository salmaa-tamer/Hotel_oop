<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" minHeight="0" minWidth="0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controllers.MakeReservationController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #2c3e50; -fx-padding: 14px 20px;">
            <Button text="← Back" onAction="#GoBackToDashboard"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6px 14px;"/>
            <Label text="Make a Reservation"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>
    <center>
        <VBox spacing="16" style="-fx-padding: 28px;">

            <!-- Date pickers side by side -->
            <HBox spacing="16">
                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Check-in date" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                    <DatePicker fx:id="checkInPicker" style="-fx-background-color: #ecf0f1;" maxWidth="Infinity" prefHeight="45"/>
                    <Label fx:id="checkInError"
                           style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"
                           visible="false" managed="false"/>
                </VBox>

                <VBox spacing="8" HBox.hgrow="ALWAYS">
                    <Label text="Check-out date" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                    <DatePicker fx:id="checkOutPicker" style="-fx-background-color: #ecf0f1;" maxWidth="Infinity" prefHeight="45"/>
                    <Label fx:id="checkOutError"     style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"
                           visible="false" managed="false"/>
                </VBox>
            </HBox>

            <!-- Room selector -->
            <VBox spacing="8">
                <Label text="Select a room" style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                <ComboBox fx:id="roomComboBox" promptText="Click to select a room..." maxWidth="Infinity"
                          style="-fx-background-color: #ecf0f1; -fx-font-size: 14px;"/>
                <Label fx:id="roomError"                        style="-fx-font-size: 14px; -fx-font-weight: bold; -fx-text-fill: #e74c3c;"
                       visible="false" managed="false"/>
            </VBox>

            <!-- Room info panel -->
            <VBox fx:id="ChosenRoomInfo" spacing="6"
                  style="-fx-background-color: #f8f9fa; -fx-padding: 14px 18px; -fx-border-color: #ecf0f1; -fx-border-radius: 8px; -fx-background-radius: 8px;"
                  visible="false" managed="false">
                <Label text="Selected Room"
                       style="-fx-font-size: 13px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="roomDetailsLabel"
                       style="-fx-font-size: 14px; -fx-text-fill: #2c3e50;"/>
                <Label fx:id="totalAmountLabel"/>
            </VBox>

        </VBox>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-background-color: #ffffff; -fx-padding: 0px 28px 28px 28px;">
            <Label fx:id="statusLabel"
                   style="-fx-font-size: 16px; -fx-font-weight: bold;"
                   maxWidth="Infinity"
                   alignment="CENTER"/>
            <Button fx:id="confirmButton" text="Confirm Reservation"
                    onAction="#handleConfirm"
                    maxWidth="Infinity"
                    style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 15px; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 12px;"/>
        </VBox>
    </bottom>

</BorderPane>