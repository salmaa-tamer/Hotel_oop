<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefWidth="1024.0" prefHeight="576.0"
            xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="GUI.Controllers.MyReservationsController">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="20"
              style="-fx-background-color: #2c3e50; -fx-padding: 14px 20px;">
            <Button text="← Back" onAction="#GoBackToDashboard"
                    style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-padding: 6px 14px;"/>
            <Label text="My Reservations"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: white;"/>
        </HBox>
    </top>

    <center>
        <VBox spacing="20" style="-fx-background-color: #ffffff; -fx-padding: 28px;">
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="Filter by status:"
                       style="-fx-font-size: 13px; -fx-text-fill: #7f8c8d;"/>
                <Button fx:id="btnAll" text="All" onAction="#FilterAll"
                        style="-fx-background-color: #2c3e50; -fx-text-fill: white; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5px 14px; -fx-cursor: hand;"/>
                <Button fx:id="btnPending" text="Pending" onAction="#FilterPending"
                        style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-border-color: #bdc3c7; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5px 14px; -fx-cursor: hand;"/>
                <Button fx:id="btnConfirmed" text="Confirmed" onAction="#FilterConfirmed"
                        style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-border-color: #bdc3c7; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5px 14px; -fx-cursor: hand;"/>
                <Button fx:id="btnCancelled" text="Cancelled" onAction="#FilterCancelled"
                        style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-border-color: #bdc3c7; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5px 14px; -fx-cursor: hand;"/>
                <Button fx:id="btnCompleted" text="Completed" onAction="#FilterCompleted"
                        style="-fx-background-color: transparent; -fx-text-fill: #2c3e50; -fx-border-color: #bdc3c7; -fx-border-radius: 20; -fx-background-radius: 20; -fx-padding: 5px 14px; -fx-cursor: hand;"/>
            </HBox>

            <ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background: transparent; -fx-border-color: transparent;">
                <VBox fx:id="Reservationlist" spacing="10">
                    <padding>
                        <Insets top="5" bottom="5"/>
                    </padding>
                </VBox>
            </ScrollPane>

        </VBox>
    </center>

</BorderPane>