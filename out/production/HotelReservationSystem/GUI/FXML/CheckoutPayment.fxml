<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane maxHeight="Infinity" maxWidth="Infinity" minHeight="0" minWidth="0"
            xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="GUI.Controllers.CheckoutPaymentController">

    <stylesheets>
        <URL value="@../CSS/styles.css" />
    </stylesheets>

    <!-- TOP BAR -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" styleClass="top-bar">
            <Label fx:id="welcomelabel" styleClass="welcome-label" text="Welcome" />
            <Label fx:id="balancelabel" styleClass="balance-label" text="Balance: $0" />
        </HBox>
    </top>

    <!-- SIDEBAR -->
    <left>
        <VBox spacing="10.0" styleClass="sidebar">
            <Label styleClass="sidebar-title" text="The Nile Atelier" />
            <Label styleClass="sidebar-subtitle" text="Checkout" />
            <Label styleClass="sidebar-subtitle" text="Payment" />
            <Separator />
         <Button mnemonicParsing="false" onAction="#goToDashboard" styleClass="sidebar-button-danger" text="← Back to Dashboard" />
        </VBox>
    </left>
   <center>
      <VBox spacing="10.0" style="-fx-background-color: #f0f2f5; -fx-padding: 30px 35px;" BorderPane.alignment="CENTER">
         <children>
            <Label styleClass="panel-title" text="Checkout &amp; Payment" />
            <Label styleClass="panel-subtitle" text="Complete your reservation payment" />
            <Separator prefWidth="200.0" />
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1a252f;" text="Select Reservation" />
                  <ComboBox fx:id="cmbReservations" prefWidth="400.0" styleClass="combo-box" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="20.0">
               <children>
                  <Label style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1a252f;" text="Payment Method " />
                  <ComboBox fx:id="cmbPaymentMethod" prefHeight="42.0" prefWidth="404.0" styleClass="combo-box" />
               </children>
            </HBox>
            <VBox spacing="12.0" style="-fx-background-color: white; -fx-padding: 25px; -fx-background-radius: 8; -fx-border-color: #d5d8dc; -fx-border-radius: 8; -fx-border-width: 1;">
               <opaqueInsets>
                  <Insets />
               </opaqueInsets>
               <children>
                  <Label style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1a252f;" text="Invoice Summary" />
                  <Separator prefWidth="200.0" />
                  <HBox spacing="20.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Guest:" />
                        <Label fx:id="lblGuestName" style="-fx-background-size: 25px;" styleClass="profile-field-value" text="-" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Room:" />
                        <Label fx:id="lblRoomNumber" styleClass="profile-field-value" text="-" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Check-In:               " />
                        <Label fx:id="lblCheckIn" styleClass="profile-field-value" text="-" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Check-Out:            " />
                        <Label fx:id="lblCheckOut" styleClass="profile-field-value" text="-" />
                     </children>
                  </HBox>
                  <HBox spacing="20.0">
                     <children>
                        <Label style="-fx-font-weight: bold;" text="Payment Method:" />
                        <Label fx:id="lblPaymentMethod" styleClass="profile-field-value" text="-" />
                     </children>
                  </HBox>
                  <Separator prefWidth="200.0" />
                  <HBox spacing="20.0">
                     <children>
                        <Label style="-fx-font-size: 18px; -fx-font-weight: bold;" text="TOTAL">
                           <opaqueInsets>
                              <Insets />
                           </opaqueInsets>
                        </Label>
                        <Label fx:id="lblTotalAmount" prefHeight="12.0" prefWidth="68.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #27ae60;" text="-" />
                     </children>
                  </HBox>
               </children>
            </VBox>
            <Label fx:id="lblMessage" prefHeight="14.0" prefWidth="979.0" />
            <Button fx:id="btnConfirmPayment" mnemonicParsing="false" onAction="#handleConfirmPayment" prefWidth="979.0" styleClass="confirm-button" text="Confirm Payment" />
         </children>
      </VBox>
   </center>

</BorderPane>
